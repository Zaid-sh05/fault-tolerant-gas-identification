# environment
.venv/
__pycache__/
.pytest_cache/
*.egg-info/

# raw data (re-downloadable from UCI #224) and saved models
data/raw/*
!data/raw/SHA256SUMS.txt
*.joblib

# overnight run: bulky intermediate artefacts (regenerated by the scripts)
results/overnight/**/*_chunks/
results/overnight/**/reduced/
results/overnight/**/*_preds.npz
results/overnight/**/detectors/
results/_backup_*/

# final-test dry run (not a result)
results/final_test_dryrun/
# final test: bulky intermediates
results/final_test/**/*_chunks/
results/final_test/**/reduced/
results/final_test/**/*_preds.npz
results/final_test/**/detectors/
results/final_test/**/models/
# integrity-check recomputation (logged in decisions_log F3)
results/final_test_check/

# v2 bulky intermediates (fits, reduced models, chunks)
results/v2/**/chunks/
results/v2/**/b*_chunks/
results/v2/**/reduced/
results/v2/**/fitted.joblib
results/v2/**/det_lpo.joblib
results/v2/recal/uncal_*/
results/v2/ft_estimate_cache/
results/v2/ft_smoke/
results/final_test_v2/**/b*_chunks/
results/final_test_v2/**/reduced/
results/final_test_v2/**/fitted.joblib
